{
  "version": 1,
  "device": {
    "keyboardLayout": "US",
    "keyDelayMs": 10
  },
  "scanner": {
    "baudrate": 9600,
    "terminators": ["0D", "0A"],
    "frameTimeoutMs": 250
  },
  "output": {
    "mode": "passthrough",
    "suffixKey": "ENTER",
    "prefixText": "",
    "suffixText": "",
    "onError": "raw"
  },
  "profiles": [
    {
      "name": "gs1-datamatrix",
      "enabled": false,
      "detect": {
        "type": "regex",
        "pattern": "^(\\]d2)?01[0-9]"
      },
      "parse": {
        "type": "gs1"
      },
      "output": [
        {"type": "field", "name": "gtin"},
        {"type": "key", "key": "TAB"},
        {"type": "field", "name": "expiryISO"},
        {"type": "key", "key": "TAB"},
        {"type": "field", "name": "batch"},
        {"type": "key", "key": "TAB"},
        {"type": "field", "name": "serial"},
        {"type": "key", "key": "ENTER"}
      ]
    },
    {
      "name": "employee-tab",
      "enabled": false,
      "detect": {
        "type": "regex",
        "pattern": "^PRC;"
      },
      "parse": {
        "type": "regexGroups",
        "pattern": "^PRC;([^;]+);([^;]+);([^;]+);([^;]+)$",
        "fields": {
          "firstName": 1,
          "lastName": 2,
          "number": 3,
          "department": 4
        }
      },
      "output": [
        {"type": "field", "name": "firstName"},
        {"type": "key", "key": "TAB"},
        {"type": "field", "name": "lastName"},
        {"type": "key", "key": "TAB"},
        {"type": "field", "name": "number"},
        {"type": "key", "key": "TAB"},
        {"type": "field", "name": "department"},
        {"type": "key", "key": "ENTER"}
      ]
    },
    {
      "name": "medicine-extension",
      "enabled": false,
      "detect": {
        "type": "regex",
        "pattern": "^(\\]d2)?01[0-9]"
      },
      "parse": {
        "type": "gs1"
      },
      "output": [
        {"type": "text", "value": "MED;"},
        {"type": "field", "name": "gtin"},
        {"type": "text", "value": ";"},
        {"type": "field", "name": "expiryISO"},
        {"type": "text", "value": ";"},
        {"type": "field", "name": "batch"},
        {"type": "text", "value": ";"},
        {"type": "field", "name": "serial"},
        {"type": "key", "key": "ENTER"}
      ]
    },
    {
      "name": "demo-prefix-P",
      "enabled": false,
      "detect": {
        "type": "regex",
        "pattern": "^P[0-9]+$"
      },
      "parse": {
        "type": "regexGroups",
        "pattern": "^(P[0-9][0-9][0-9])([0-9]+)$",
        "fields": {
          "header": 1,
          "number": 2
        }
      },
      "output": [
        {"type": "field", "name": "header"},
        {"type": "key", "key": "TAB"},
        {"type": "field", "name": "number"},
        {"type": "key", "key": "ENTER"}
      ]
    }
  ]
}
