{
  "version": 1,
  "lang": "en",
  "enabled": true,
  "settings": {
    "scanGapMs": 60,
    "minFrameLength": 3,
    "stepPauseMs": 40,
    "verifyByReadback": true
  },
  "profiles": [
    {
      "id": "employee-card",
      "name": "Employee card (test)",
      "enabled": true,
      "match": {
        "process": "MystticDemoApp",
        "titlePattern": "*Employee card*"
      },
      "parse": {
        "type": "delimited",
        "prefix": "PRC;",
        "separator": ";",
        "fields": [
          "_",
          "firstName",
          "lastName",
          "number",
          "department",
          "position"
        ]
      },
      "steps": [
        {
          "action": "field",
          "target": {
            "automationId": "txtFirstName"
          },
          "value": "{firstName}"
        },
        {
          "action": "field",
          "target": {
            "automationId": "txtLastName"
          },
          "value": "{lastName}"
        },
        {
          "action": "field",
          "target": {
            "automationId": "txtNumber"
          },
          "value": "{number}"
        },
        {
          "action": "field",
          "target": {
            "automationId": "cmbDepartment"
          },
          "value": "{department}"
        },
        {
          "action": "field",
          "target": {
            "automationId": "cmbPosition"
          },
          "value": "{position}",
          "mode": "type"
        }
      ]
    }
  ]
}
